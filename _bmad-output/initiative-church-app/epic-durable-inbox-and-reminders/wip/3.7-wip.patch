+---
+title: 'Show the inbox, notification settings and snooze on mobile and staff web'
+type: 'feature'
+ticket: '7'
+created: '2026-10-08'
+status: 'in-progress'
+baseline_revision: '5db8b266ebaaed7cc690a318df528e524b9642b0'
+route: 'full'
+route_source: 'auto'
+review: ''
+review_source: ''
+lenses_ran: []
+review_loop_iteration: 0
+context:
